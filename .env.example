# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# LLM provider (OpenRouter — https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...
# Optional: override the default model (default: anthropic/claude-haiku-4-5)
# Free models — see https://openrouter.ai/models?q=free for current availability
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# MCP server URL
# Local dev:  http://localhost:8001
# Production: set to the deployed service URL
MCP_SERVER_URL=http://localhost:8001
