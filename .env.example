# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# LLM provider (OpenRouter — https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...
# Optional: override the app's current default model.
# Check provider availability before choosing a free model.
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# MCP server URL
# Base URL for the local MCP process; the SDK client connects to /mcp.
# Production also uses localhost in the single-service deployment.
MCP_SERVER_URL=http://localhost:8001

# Admin panel (/admin) login — protects employee chat logs and HR tickets.
# REQUIRED in production: without ADMIN_PASSWORD set, /admin login is
# disabled entirely (fails closed, not to a guessable default).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs the admin session cookie. REQUIRED in production — without it, a
# random secret is generated per process start, meaning every restart logs
# all admins out. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
