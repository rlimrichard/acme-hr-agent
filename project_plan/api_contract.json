{
  "endpoints": {
    "POST /chat": {
      "request": {
        "type": "object",
        "properties": {
          "query":       { "type": "string",  "description": "The user's natural language question or request" },
          "employee_id": { "type": "string",  "pattern": "^EMP-\\d{3}$", "description": "Must match the signed-in employee's ID, e.g. 'EMP-002'" },
          "confirmed": { "type": "boolean", "default": false, "description": "Explicit second-step confirmation for an eligible internal mock ticket; this demo does not use a one-time confirmation token" },
          "top_k": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5, "description": "Primary policy-search retrieval depth" }
        },
        "required": ["query", "employee_id"]
      },
      "response": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "description": "Final synthesized answer with inline citations"
          },
          "citations": {
            "type": "array",
            "description": "Policy sources used to generate the answer",
            "items": {
              "type": "object",
              "properties": {
                "doc_id":    { "type": "string" },
                "doc_title": { "type": "string" },
                "section":   { "type": "string" }
              }
            }
          },
          "snippets": {
            "type": "array",
            "description": "Raw retrieved text chunks shown to the user",
            "items": {
              "type": "object",
              "properties": {
                "doc_id":  { "type": "string" },
                "section": { "type": "string" },
                "text":    { "type": "string" }
              }
            }
          },
          "tool_trace": {
            "type": "array",
            "description": "Ordered log of every MCP tool call made to answer this query",
            "items": {
              "type": "object",
              "properties": {
                "step":   { "type": "integer" },
                "tool":   { "type": "string" },
                "args":   { "type": "object" },
                "result": { "type": "object" }
              }
            }
          },
          "escalated": {
            "type": "boolean",
            "description": "True if the agent determined the question is out of scope or requires human HR"
          },
          "escalation_message": {
            "type": ["string", "null"],
            "description": "Optional user-facing escalation explanation"
          },
          "requires_confirmation": {
            "type": "boolean",
            "description": "Whether the UI should offer a confirmation choice before creating an internal mock ticket"
          }
        },
        "required": ["answer", "citations", "snippets", "tool_trace", "escalated", "escalation_message", "requires_confirmation"]
      }
    },
    "GET /health": {
      "response": {
        "type": "object",
        "properties": {
          "status":        { "type": "string", "enum": ["ok", "degraded"] },
          "mcp_connected": { "type": "boolean" },
          "chroma_loaded": { "type": "boolean" },
          "doc_count":     { "type": "integer" },
          "tool_count":    { "type": "integer" },
          "version":       { "type": "string" }
        },
        "required": ["status", "mcp_connected", "chroma_loaded", "doc_count", "tool_count", "version"]
      }
    }
  }
}
